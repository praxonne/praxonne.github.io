---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="The requested Praxonne page could not be found.">
  <section class="not-found">
    <p class="eyebrow">404 · route not found</p>
    <h1>This path has no handler.</h1>
    <p>The proxy failed closed. Head back to the public architecture.</p>
    <a class="button primary" href="/">Return home <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
